---
import ElevatedSecurityBadge from './ElevatedSecurityBadge.astro';

import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import award from '../assets/images/angies-award.png';
import { navigation, services, site, trustPoints } from '../data/site';
---
<section class="cta" aria-labelledby="cta-heading">
  <svg class="cta-drops" viewBox="0 0 200 200" aria-hidden="true"><path d="M60 20c18 26 30 42 30 58a30 30 0 0 1-60 0c0-16 12-32 30-58Z"/><path d="M150 90c12 17 20 28 20 39a20 20 0 0 1-40 0c0-11 8-22 20-39Z"/><path d="M95 140c8 11 13 18 13 25a13 13 0 0 1-26 0c0-7 5-14 13-25Z"/></svg>
  <div class="container cta-inner">
    <div class="cta-copy">
      <p class="cta-eyebrow">Drips, clogs &amp; cold showers?</p>
      <h2 id="cta-heading">Let’s get things flowing again!</h2>
      <p class="cta-lead">
        From a dripping faucet to a water heater that’s called it quits, our friendly, family-owned team is ready to help —
        often the same day. We explain everything before we start, so there are never any surprises.
      </p>
      <p class="cta-care">Patient, respectful service for seniors and families alike — we’ll walk you through every step.</p>
      <div class="cta-actions">
        <a class="cta-call" href={site.phoneHref}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
          <span><small>Call us today</small>{site.phoneDisplay}</span>
        </a>
        <a class="cta-schedule" href="/contact-us/">Schedule Service</a>
      </div>
    </div>
    <ul class="cta-trust">
      {trustPoints.map((point) => (
        <li>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="m7 12.5 3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>{point.title}</strong>{point.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer class="site-footer">
  <svg class="footer-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40c120 30 240 45 360 30S600 10 720 22s240 50 360 46 240-36 360-38v60H0Z" fill="currentColor" opacity=".35"/><path d="M0 58c160 22 300 30 450 14s290-34 420-20 260 42 380 36 130-20 190-24v26H0Z" fill="currentColor"/></svg>
  <svg class="footer-glow" viewBox="0 0 400 300" aria-hidden="true"><defs><linearGradient id="dropfill" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5fc3ef" stop-opacity=".45"/><stop offset="1" stop-color="#1686b6" stop-opacity=".05"/></linearGradient></defs><path d="M110 20c30 44 50 72 50 98a50 50 0 0 1-100 0c0-26 20-54 50-98Z" fill="url(#dropfill)"/><path d="M300 120c20 29 33 47 33 64a33 33 0 0 1-66 0c0-17 13-35 33-64Z" fill="url(#dropfill)"/><path d="M220 200c12 17 19 28 19 37a19 19 0 0 1-38 0c0-9 7-20 19-37Z" fill="url(#dropfill)"/></svg>
  <div class="footer-drops" aria-hidden="true">
    {Array.from({ length: 9 }, (_, i) => <span style={`--i:${i};--size:${12 + ((i * 5) % 16)}px`}></span>)}
  </div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Advantage Plumbing home"><Logo /></a>
      <p class="footer-tagline">{site.tagline}</p>
      <p>Keeping homes across Omaha, Bellevue and Council Bluffs warm, dry and flowing — one friendly service call at a time.</p>
      <a class="footer-award" href="/#award">
        <Image src={award} alt="2019 Angie's List Super Service Award" widths={[96, 192]} sizes="64px" loading="lazy" />
        <span><strong>Angie’s List Super Service Award</strong>Top-rated in Omaha, 2015–2019</span>
      </a>
    </div>
    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <div>
      <h2>Our Services</h2>
      <ul>{services.map((service) => <li><a href={service.href}>{service.title}</a></li>)}</ul>
    </div>
    <div class="footer-contact">
      <h2>Contact</h2>
      <a class="footer-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
      <dl>
        {site.hours.map(([days, time]) => <div><dt>{days}</dt><dd>{time}</dd></div>)}
      </dl>
      <p>Serving {site.serviceArea}.</p>
    </div>
  </div>
  <div class="legal">
    <div class="container legal-inner">
      <span>© {new Date().getFullYear()} Advantage Plumbing. Family owned &amp; master plumber led.</span>

      <a href="#main-content">Back to top ↑</a>
    </div>
  </div>
<ElevatedSecurityBadge />
</footer>

<style>
  .cta { position: relative; overflow: hidden; padding: clamp(3.5rem, 7vw, 5.5rem) 0; color: #fff; background: radial-gradient(circle at 85% 20%, rgba(22,134,182,.55), transparent 55%), linear-gradient(120deg, var(--navy) 0%, #0d4a6e 100%); }
  .cta::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; background: repeating-linear-gradient(90deg, var(--orange) 0 40px, #ff8a57 40px 80px); }
  .cta-drops { position: absolute; right: -30px; bottom: -40px; width: 320px; height: 320px; fill: rgba(255,255,255,.06); }
  .cta-inner { position: relative; display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .cta-eyebrow { display: inline-block; margin: 0 0 .9rem; padding: .35rem .8rem; border-radius: 999px; background: var(--orange); font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .cta h2 { margin: 0 0 1rem; color: #fff; font-size: clamp(2rem, 4.2vw, 3.1rem); }
  .cta-lead { margin: 0 0 .8rem; font-size: 1.15rem; color: #dbe8ef; max-width: 620px; }
  .cta-care { margin: 0 0 1.8rem; color: #fff; font-weight: 700; font-size: 1.05rem; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .cta-call { display: inline-flex; align-items: center; gap: .85rem; padding: .85rem 1.5rem; border-radius: 6px; background: var(--orange); color: #fff; text-decoration: none; font-size: 1.45rem; font-weight: 800; line-height: 1.1; box-shadow: 0 10px 24px rgba(231,86,37,.35); transition: transform .2s, background .2s; }
  .cta-call small { display: block; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; opacity: .9; }
  .cta-call:hover { background: #ff6a35; transform: translateY(-2px); }
  .cta-schedule { display: inline-flex; align-items: center; min-height: 56px; padding: .75rem 1.5rem; border: 2px solid rgba(255,255,255,.75); border-radius: 6px; color: #fff; text-decoration: none; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; font-size: .85rem; }
  .cta-schedule:hover { background: #fff; color: var(--navy); }
  .cta-trust { list-style: none; margin: 0; padding: 1.6rem; display: grid; gap: 1.1rem; border-radius: 10px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); }
  .cta-trust li { display: flex; gap: .85rem; align-items: flex-start; color: #cfe0ea; }
  .cta-trust svg { flex: none; color: var(--orange); margin-top: .15rem; }
  .cta-trust strong { display: block; color: #fff; font-size: 1.05rem; }
  @media (max-width: 860px) { .cta-inner { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .cta-call { width: 100%; justify-content: center; } .cta-schedule { width: 100%; justify-content: center; } }

  .site-footer { position: relative; overflow: hidden; padding-top: 5.5rem; color: #b9cad6; font-size: .98rem;
    background:
      radial-gradient(ellipse 60% 50% at 10% 0%, rgba(22,134,182,.35), transparent 70%),
      radial-gradient(ellipse 50% 60% at 95% 100%, rgba(231,86,37,.18), transparent 70%),
      radial-gradient(circle at 70% 30%, rgba(22,134,182,.14), transparent 40%),
      linear-gradient(180deg, #0a3553 0%, #061f31 55%, #04172a 100%); }
  .footer-wave { position: absolute; top: -1px; left: 0; width: 100%; height: 70px; color: #0d4a6e; transform: scaleY(-1); }
  .footer-drops { position: absolute; inset: 0; pointer-events: none; }
  .footer-glow { position: absolute; right: -40px; bottom: 40px; width: 420px; height: 320px; pointer-events: none; opacity: .9; }
  @media (max-width: 760px) { .footer-glow { width: 260px; height: 200px; right: -60px; } }
  .footer-drops span {
    position: absolute; top: -40px; left: calc(4% + var(--i) * 11.5%);
    width: var(--size); aspect-ratio: 1;
    opacity: 0; animation: drip calc(6s + var(--i) * 1.1s) cubic-bezier(.45,.05,.8,.6) calc(var(--i) * -1.9s) infinite;
  }
  .footer-drops span::before {
    content: ''; position: absolute; inset: 0; transform: rotate(-45deg);
    border-radius: 0 50% 50% 50%;
    background: radial-gradient(circle at 40% 40%, rgba(255,255,255,.95) 0 10%, rgba(120,200,235,.7) 35%, rgba(22,134,182,.35) 80%);
    box-shadow: 0 0 10px rgba(120,200,235,.55);
  }
  @keyframes drip { 0% { transform: translateY(0) scale(.9); opacity: 0; } 8% { opacity: .85; } 80% { opacity: .6; } 100% { transform: translateY(620px) scale(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .footer-drops span { animation: none; opacity: .45; top: calc(15% + var(--i) * 8%); } }
  .footer-grid { position: relative; display: grid; grid-template-columns: 1.6fr .9fr 1.1fr 1.2fr; gap: 2.5rem; padding-bottom: 3.5rem; }
  .footer-logo { display: inline-block; filter: drop-shadow(0 6px 16px rgba(0,0,0,.35)); }
  .footer-logo :global(img) { width: 260px; }
  .footer-tagline { margin: 1.1rem 0 .4rem; color: #fff; font-weight: 800; font-size: 1.05rem; }
  .footer-award { display: flex; gap: .9rem; align-items: center; margin-top: 1.4rem; padding: .8rem 1rem; border-radius: 10px; background: linear-gradient(135deg, rgba(255,255,255,.1), rgba(255,255,255,.03)); border: 1px solid rgba(255,255,255,.12); color: #cfe0ea; text-decoration: none; max-width: 360px; backdrop-filter: blur(4px); }
  .footer-award :global(img) { width: 64px; height: auto; flex: none; }
  .footer-award strong { display: block; color: #fff; }
  .footer-award:hover { background: rgba(255,255,255,.14); }
  .site-footer h2 { margin: 0 0 1.1rem; color: #fff; font-size: .95rem; letter-spacing: .12em; text-transform: uppercase; }
  .site-footer h2::after { content: ''; display: block; width: 32px; height: 3px; margin-top: .55rem; background: var(--orange); }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer li { margin: .55rem 0; }
  .site-footer a { color: #fff; text-decoration: none; }
  .site-footer a:hover { color: #ff9a68; }
  .footer-phone { display: inline-block; margin-bottom: 1rem; font-size: 1.6rem; font-weight: 800; color: #fff; background: linear-gradient(90deg, #fff, #ffb48f); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .footer-phone:hover { -webkit-text-fill-color: #ff9a68; }
  .footer-contact dl { margin: 0 0 1rem; }
  .footer-contact dl div { display: flex; justify-content: space-between; gap: 1rem; padding: .45rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
  .footer-contact dd { margin: 0; color: #fff; }
  .legal { position: relative; padding: 1.2rem 0; font-size: .85rem; background: rgba(0,0,0,.25); border-top: 1px solid transparent; border-image: linear-gradient(90deg, transparent, rgba(22,134,182,.7), rgba(231,86,37,.7), transparent) 1; }
  .legal-inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .secured { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .75rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.05); }
  .secured svg { color: #5fd38a; }
  .secured:hover { border-color: rgba(255,255,255,.4); }
  @media (max-width: 960px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
