---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
---
<span class:list={['logo', { inverse }]}><Image src={logo} alt="Advantage Plumbing" widths={[220, 320]} sizes="(max-width: 500px) 220px, 280px" loading="eager" /></span>

<style>
  .logo{display:inline-flex;align-items:center}.logo :global(img){display:block;width:280px;height:auto}.logo.inverse{filter:brightness(0) invert(1)}@media(max-width:500px){.logo :global(img){width:220px}}
</style>
