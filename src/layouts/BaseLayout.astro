---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; image?: string; noindex?: boolean }
const { title, description, image = '/og.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Advantage Plumbing') ? title : `${title} | Advantage Plumbing`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="generator" content={Astro.generator} /><title>{fullTitle}</title><meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, follow" />}<link rel="canonical" href={canonical} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Advantage Plumbing" /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:locale" content="en_US" /><meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:image:type" content="image/jpeg" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Advantage Plumbing — Your In-Home Plumbing Specialist" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(image, Astro.site)} /><meta name="twitter:image:alt" content="Advantage Plumbing — Your In-Home Plumbing Specialist" /><meta name="theme-color" content="#092f49" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" /><link rel="sitemap" type="application/xml" href="/sitemap.xml" /><script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4TCYM1BZYM"></script><script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-4TCYM1BZYM');</script><script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org','@type':'Plumber',name:'Advantage Plumbing',url:'https://advantageplumbinginc.com',telephone:'+1-402-614-2673',logo:'https://advantageplumbinginc.com/icon-512.png',image:'https://advantageplumbinginc.com/og.jpg',slogan:'Your In-Home Plumbing Specialist',openingHours:'Mo-Fr 08:00-16:30',award:"2019 Angie's List Super Service Award",sameAs:['https://maps.app.goo.gl/zJ766SZ2qaHgPJEx7'],areaServed:['Omaha, NE','Bellevue, NE','Council Bluffs, IA'] })}></script></head><body><Header /><main id="main-content"><slot /></main><Footer /></body></html>
