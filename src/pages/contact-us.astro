---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---
<BaseLayout title="Schedule a Service" description="Call Advantage Plumbing to schedule residential plumbing service in Omaha, Bellevue, Council Bluffs and surrounding areas.">
  <PageHero title="Schedule a Service" intro="Tell us how we can help with your in-home plumbing needs." />
  <section class="section"><div class="container contact-grid"><div><p class="eyebrow">Contact Advantage Plumbing</p><h2>Let’s get your plumbing working properly.</h2><p>Call to discuss your plumbing needs and schedule service throughout {site.serviceArea}.</p><a class="call-card" href={site.phoneHref}><small>Call us</small><strong>{site.phoneDisplay}</strong></a><div class="notice"><strong>What to expect when you call</strong><ul><li>A real, friendly person from our small family-owned team</li><li>Same-day service available throughout the Omaha region</li><li>We explain the work and the price before we start</li><li>We keep you informed and clean as we go</li></ul></div></div><aside><h2>Service Hours</h2><dl><div><dt>Monday–Friday</dt><dd>8:00 AM–4:30 PM</dd></div><div><dt>Saturday–Sunday</dt><dd>Closed</dd></div></dl><p>For scheduling, please call during service hours.</p><a class="button" href={site.phoneHref}>Call to Schedule</a></aside></div></section>
</BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:4rem}.call-card{display:inline-flex;flex-direction:column;padding:1.4rem 2rem;margin:1rem 0 2rem;background:var(--orange);color:#fff;text-decoration:none}.call-card small{text-transform:uppercase;letter-spacing:.1em}.call-card strong{font-size:2rem}.notice{padding:1.5rem 1.75rem;background:var(--pale);border-left:5px solid var(--orange)}.notice ul{margin:.6rem 0 0;padding-left:1.2rem}.notice li{margin:.35rem 0}aside{padding:2.5rem;background:var(--navy);color:#fff}aside h2{color:#fff}dl div{display:flex;justify-content:space-between;gap:1rem;padding:.9rem 0;border-bottom:1px solid rgba(255,255,255,.15)}dd{margin:0}@media(max-width:750px){.contact-grid{grid-template-columns:1fr}}</style>
