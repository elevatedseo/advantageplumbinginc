---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/site';
---
<BaseLayout title="Advantage Plumbing | Omaha's In-Home Plumbing Specialist" description="Advantage Plumbing provides plumbing, drain, water heater and water treatment services in Omaha, Bellevue, Council Bluffs and surrounding areas.">
  <section class="hero"><div class="container"><div class="hero-copy"><p class="eyebrow">{site.tagline}</p><h1>Complete Tub and Shower Replacement</h1><p>Trusted residential plumbing service throughout the Omaha region.</p><div class="actions"><a class="button" href="/contact-us/">Schedule a Service</a><a class="phone" href={site.phoneHref}>Call {site.phoneDisplay}</a></div></div><div class="hero-art" aria-label="Approved Bath Remodel Header image pending"><span>Approved hero image pending</span></div></div></section>
  <section class="section"><div class="container split"><div><p class="eyebrow">Welcome to Advantage Plumbing</p><h2>Your In-Home Plumbing Specialist</h2><p>The plumbing inside of your home is one of its most vital components. It needs to be functioning properly in order for you to cook, clean, bathe, and live, as water is the element of life. Even the slightest problem can cause more than just an inconvenience, and fixing these problems are far out of the abilities of the average homeowner. Expert plumbers are a vital asset to your home.</p><p>Advantage Plumbing is an established company in the Omaha, Bellevue, Council Bluffs and surrounding areas. We are dedicated to providing our customers with outstanding service and quality work and we look forward to creating a long-lasting relationship with you.</p><p><strong>Advantage Plumbing is available for same day plumbing services throughout the entire Omaha region.</strong></p></div><ImagePlaceholder label="Advantage Plumbing in-home service" /></div></section>
  <section class="section band"><div class="container"><p class="eyebrow center">How we can help</p><h2 class="center">Professional plumbing services</h2><ServiceCards /></div></section>
  <section class="section award"><div class="container split"><div class="award-mark" aria-hidden="true"><span>2019</span><strong>Super Service Award</strong></div><div><p class="eyebrow">Recognized service</p><h2>2019 Angies List Super Service Award</h2><p>We were among the top companies to be awarded Angie’s List awards for the services offered, guarantee of our services and quality. From 2015 to 2019, we pride ourselves as a top rated plumbing services in Omaha!</p></div></div></section>
  <section class="section team"><div class="container"><p class="eyebrow center">Meet the people who help</p><h2 class="center">Our Team Members</h2><div class="team-grid">{['Mike Luty','Brenden','Joe','Debi'].map(name => <article><ImagePlaceholder label={name} /><h3>{name}</h3></article>)}</div></div></section>
  <Testimonials />
</BaseLayout>
<style>.hero{min-height:650px;display:grid;align-items:center;overflow:hidden;background:linear-gradient(115deg,#e9f3f6 0 58%,#bdd6df 58%)}.hero>.container{display:grid;grid-template-columns:1.05fr .95fr;align-items:center}.hero-copy{position:relative;z-index:2;padding:5rem 0}.hero h1{margin:.3rem 0 1.25rem}.hero-copy>p:not(.eyebrow){max-width:550px;font-size:1.15rem}.actions{display:flex;gap:1.2rem;align-items:center;margin-top:2rem}.phone{font-weight:800;color:var(--navy)}.hero-art{height:560px;display:grid;place-items:end center;padding:2rem;background:linear-gradient(145deg,transparent 20%,rgba(22,134,182,.2));color:var(--navy);font-weight:800;text-transform:uppercase;letter-spacing:.1em}.center{text-align:center}.band h2{margin-top:.3rem;margin-bottom:3rem}.award-mark{width:min(350px,100%);aspect-ratio:1;display:grid;place-content:center;text-align:center;border:14px double var(--orange);border-radius:50%;color:var(--navy)}.award-mark span{font-size:5rem;font-weight:900;line-height:1}.award-mark strong{text-transform:uppercase;letter-spacing:.06em}.team{background:var(--navy);color:#fff}.team h2{color:#fff}.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}.team-grid article{background:#fff}.team-grid h3{padding:0 1.25rem 1rem}@media(max-width:800px){.hero{min-height:auto;background:#e9f3f6}.hero>.container{grid-template-columns:1fr}.hero-art{height:220px}.team-grid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.actions{align-items:flex-start;flex-direction:column}.team-grid{grid-template-columns:1fr}}</style>
