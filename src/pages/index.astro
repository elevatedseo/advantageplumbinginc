---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import heroBath from '../assets/images/hero-bath.webp';
import heroHeater from '../assets/images/hero-water-heater.webp';
import heroGarbage from '../assets/images/hero-garbage-disposal.webp';
import welcome from '../assets/images/welcome-service.webp';
import award from '../assets/images/angies-award.png';
import brenden from '../assets/images/team-brenden.webp';
import joe from '../assets/images/team-joe.webp';
import debi from '../assets/images/team-debi.webp';
import brand1 from '../assets/images/brand-1.webp';
import brand2 from '../assets/images/brand-2.webp';
import brand3 from '../assets/images/brand-3.webp';
import brand4 from '../assets/images/brand-4.webp';
import brand5 from '../assets/images/brand-5.webp';
import brand6 from '../assets/images/brand-6.webp';
import brand7 from '../assets/images/brand-7.webp';
import brand8 from '../assets/images/brand-8.webp';
import brand9 from '../assets/images/brand-9.webp';
import brand10 from '../assets/images/brand-10.webp';
import brand11 from '../assets/images/brand-11.webp';
import brand12 from '../assets/images/brand-12.webp';
const slides = [
  { image: heroBath, title: 'Complete Tub and Shower Replacement', alt: 'Completed tub and shower remodel' },
  { image: heroHeater, title: 'Water Heater Replacement and Repairs', alt: 'Residential hot water heater' },
  { image: heroGarbage, title: 'Garbage Disposal Replacement or Repair', alt: 'Kitchen garbage disposal' },
];
const team = [{name:'Brenden',image:brenden},{name:'Joe',image:joe},{name:'Debi',image:debi}];
const brands = [brand1,brand2,brand3,brand4,brand5,brand6,brand7,brand8,brand9,brand10,brand11,brand12];
---
<BaseLayout title="Advantage Plumbing | Omaha's In-Home Plumbing Specialist" description="Advantage Plumbing provides plumbing, drain, water heater and water treatment services in Omaha, Bellevue, Council Bluffs and surrounding areas.">
  <section class="hero" aria-label="Featured plumbing services"><div class="slides">{slides.map((slide,index) => <article class="slide" style={`--slide:${index}`}><Image src={slide.image} alt={slide.alt} widths={[768,1280,1920]} sizes="100vw" loading={index === 0 ? 'eager' : 'lazy'} /><div class="overlay"></div><div class="container hero-copy"><p class="eyebrow">{site.tagline}</p><h1>{slide.title}</h1><div class="actions"><a class="button" href="/contact-us/">Schedule a Service</a><a class="phone" href={site.phoneHref}>Call {site.phoneDisplay}</a></div></div></article>)}</div></section>
  <section class="section"><div class="container split"><div><p class="eyebrow">Welcome to Advantage Plumbing</p><h2>Your In-Home Plumbing Specialist</h2><p>The plumbing inside of your home is one of its most vital components. It needs to be functioning properly in order for you to cook, clean, bathe, and live, as water is the element of life. Even the slightest problem can cause more than just an inconvenience, and fixing these problems are far out of the abilities of the average homeowner. Expert plumbers are a vital asset to your home.</p><p>Advantage Plumbing is an established company in the Omaha, Bellevue, Council Bluffs and surrounding areas. We are dedicated to providing our customers with outstanding service and quality work and we look forward to creating a long-lasting relationship with you.</p><p><strong>Advantage Plumbing is available for same day plumbing services throughout the entire Omaha region.</strong></p></div><Image class="welcome-image" src={welcome} alt="Advantage Plumbing residential service work" widths={[600,900]} sizes="(max-width: 760px) 100vw, 50vw" /></div></section>
  <section class="section band"><div class="container"><p class="eyebrow center">How we can help</p><h2 class="center">Professional plumbing services</h2><ServiceCards /></div></section>
  <section class="section award"><div class="container split"><Image class="award-image" src={award} alt="2019 Angie's List Super Service Award" widths={[350,600]} sizes="(max-width: 760px) 80vw, 35vw" /><div><p class="eyebrow">Recognized service</p><h2>2019 Angies List Super Service Award</h2><p>We were among the top companies to be awarded Angie’s List awards for the services offered, guarantee of our services and quality. From 2015 to 2019, we pride ourselves as a top rated plumbing services in Omaha!</p></div></div></section>
  <section class="section team"><div class="container"><p class="eyebrow center">Meet the people who help</p><h2 class="center">Our Team Members</h2><div class="team-grid"><article><ImagePlaceholder label="Mike Luty — portrait filename not verified" /><h3>Mike Luty</h3></article>{team.map(person => <article><Image src={person.image} alt={`${person.name}, Advantage Plumbing team member`} widths={[300,500]} sizes="(max-width: 500px) 100vw, 25vw" /><h3>{person.name}</h3></article>)}</div></div></section>
  <Testimonials />
  <section class="section brands"><div class="container"><p class="eyebrow center">Trusted products</p><h2 class="center">Our Brands</h2><div class="brand-grid">{brands.map((brand,index) => <Image src={brand} alt={`Plumbing product brand ${index + 1}`} widths={[150,300]} sizes="150px" />)}</div></div></section>
</BaseLayout>
<style>.hero{min-height:650px;display:grid;align-items:center;overflow:hidden;background:linear-gradient(115deg,#e9f3f6 0 58%,#bdd6df 58%)}.hero>.container{display:grid;grid-template-columns:1.05fr .95fr;align-items:center}.hero-copy{position:relative;z-index:2;padding:5rem 0}.hero h1{margin:.3rem 0 1.25rem}.hero-copy>p:not(.eyebrow){max-width:550px;font-size:1.15rem}.actions{display:flex;gap:1.2rem;align-items:center;margin-top:2rem}.phone{font-weight:800;color:var(--navy)}.hero-art{height:560px;display:grid;place-items:end center;padding:2rem;background:linear-gradient(145deg,transparent 20%,rgba(22,134,182,.2));color:var(--navy);font-weight:800;text-transform:uppercase;letter-spacing:.1em}.center{text-align:center}.band h2{margin-top:.3rem;margin-bottom:3rem}.award-mark{width:min(350px,100%);aspect-ratio:1;display:grid;place-content:center;text-align:center;border:14px double var(--orange);border-radius:50%;color:var(--navy)}.award-mark span{font-size:5rem;font-weight:900;line-height:1}.award-mark strong{text-transform:uppercase;letter-spacing:.06em}.team{background:var(--navy);color:#fff}.team h2{color:#fff}.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}.team-grid article{background:#fff}.team-grid h3{padding:0 1.25rem 1rem}@media(max-width:800px){.hero{min-height:auto;background:#e9f3f6}.hero>.container{grid-template-columns:1fr}.hero-art{height:220px}.team-grid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.actions{align-items:flex-start;flex-direction:column}.team-grid{grid-template-columns:1fr}}</style>
<style>
  .hero{position:relative;height:650px;min-height:650px;display:block;background:var(--navy)}.slides,.slide{position:absolute;inset:0}.slide{opacity:0;animation:hero-cycle 18s infinite;animation-delay:calc(var(--slide) * 6s)}.slide :global(> picture img),.slide :global(> img){width:100%;height:100%;object-fit:cover}.overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,31,49,.92),rgba(5,31,49,.35) 65%,rgba(5,31,49,.12))}.hero-copy{position:absolute;inset:0;z-index:2;display:flex;justify-content:center;align-items:flex-start;flex-direction:column;padding:0;color:#fff}.hero h1{max-width:760px;color:#fff}.phone{color:#fff}.welcome-image{width:100%;max-height:520px;object-fit:cover}.award-image{width:min(430px,100%);margin:auto}.team-grid article{overflow:hidden}.team-grid article :global(img){width:100%;height:300px;object-fit:cover}.brand-grid{display:grid;grid-template-columns:repeat(6,1fr);align-items:center;gap:1.5rem;margin-top:2.5rem}.brand-grid :global(img){width:100%;height:70px;object-fit:contain}@keyframes hero-cycle{0%,30%{opacity:1}33%,96%{opacity:0}100%{opacity:1}}@media(prefers-reduced-motion:reduce){.slide{animation:none}.slide:first-child{opacity:1}}@media(max-width:800px){.hero{height:560px;min-height:560px}.brand-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:500px){.brand-grid{grid-template-columns:repeat(2,1fr)}}
</style>
